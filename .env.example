# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=isnad_graph_dev

# PostgreSQL
PG_DSN=postgresql://isnad:isnad_dev@localhost:5432/isnad_graph

# APIs
SUNNAH_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Data paths
DATA_RAW_DIR=./data/raw
DATA_STAGING_DIR=./data/staging
DATA_CURATED_DIR=./data/curated

# Resolve / dedup
# Whether the dedup stage's declared ML dependencies (the `ml` group:
# sentence-transformers, faiss) are mandatory. `true` (the default) makes an
# enabled dedup stage fail loud when a dep is absent, instead of writing a
# zero-row parallel_links.parquet that downstream reads as "no parallels found".
# Set to `false` only to opt in deliberately to the deterministic no-model
# fallback in src/resolve/parallels.py. Install the deps with: uv sync --group ml
DEDUP_REQUIRE_ML=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
